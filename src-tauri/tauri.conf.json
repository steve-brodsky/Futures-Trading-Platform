{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northstar Trader",
  "version": "0.1.0",
  "identifier": "com.northstar.trader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Northstar Trader",
        "width": 1512,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Private futures trading workspace for TradeStation"
  }
}
